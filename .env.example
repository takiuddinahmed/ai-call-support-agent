# Store API. Leave the key empty to read it from the store container.
STORE_URL=http://localhost:9000
STORE_PUBLISHABLE_KEY=

# Local model server (Ollama, OpenAI-compatible API)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.5:4b-q4_K_M
LLM_API_KEY=ollama
# Hidden thinking: none (fast, but skips tools), low, medium, high. Empty = model default.
LLM_REASONING_EFFORT=low

# Agent limits
MAX_TOOL_ROUNDS=6
CATALOG_CACHE_SECONDS=300

# Voice channel: speech-to-text model (MLX Whisper), Kokoro voice, Asterisk WebSocket path
VOICE_STT_MODEL=mlx-community/whisper-large-v3-turbo
VOICE_TTS_VOICE=af_heart
VOICE_ASTERISK_PATH=/api/voice/asterisk
